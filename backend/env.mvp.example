# MVP backend — no database. Copy to .env for local or VPS (see deploy/vps/README.md).

PORT=3001
NODE_ENV=production

STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional placeholders (MVP uses per-invoice sellerPublicKey from the wallet)
SELLER_PUBLIC_KEY=
SELLER_SECRET_KEY=

# Must match the deployed frontend origin (CORS), no trailing slash
# Local:  http://localhost:3000
# Prod:   https://YOUR-APP.vercel.app
FRONTEND_URL=http://localhost:3000

# Local testing only — leave unset/false in production demos
ALLOW_SIMULATE=false

# Opt-in rate limiting (in-memory stub) — leave unset/false for default no-op
RATE_LIMIT_ENABLED=false
