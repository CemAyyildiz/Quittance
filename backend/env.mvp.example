#MVP backend — no database. Copy to .env for local or VPS (see deploy/vps/README.md).

PORT=3001
NODE_ENV=production

STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional placeholders (MVP uses per-invoice sellerPublicKey from the wallet)
SELLER_PUBLIC_KEY=
SELLER_SECRET_KEY=

# Must match the deployed frontend origin (CORS), no trailing slash
# Local:  http://localhost:3000
# Prod:   https://YOUR-APP.vercel.app
FRONTEND_URL=http://localhost:3000

# Local testing only — leave unset/false in production demos
ALLOW_SIMULATE=false

# Opt-in per-IP rate limiting (in-memory stub) — leave unset/false for default no-op
RATE_LIMIT_ENABLED=false

# Per-seller create / per-invoice verify limits (on by default for MVP)
# SELLER_RATE_LIMIT_ENABLED=false
# SELLER_RATE_LIMIT_WINDOW_MS=60000
# SELLER_RATE_LIMIT_MAX=60

# Optional paid-invoice webhook. Delivery requires BOTH values; with either
# unset no webhook is sent. Body is signed with HMAC-SHA256 in
# X-Quittance-Signature (sha256=<hex>).
# WEBHOOK_URL=https://example.com/hooks/quittance
# WEBHOOK_SECRET=change-me
