# ----------------------------------------------------------------------------
# Quittance MVP Frontend — Environment Configuration Template
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` for local Next.js development or set these
# variables in your deployment platform (e.g., Vercel Project Settings).
#
# Usage:
#   Local Development:   cp deploy/frontend.env.example frontend/.env.local
#   Production / Vercel: Configure environment variables under Project Settings -> Environment Variables
#
# Note on Next.js Variables:
#   Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser bundle.
#   Do NOT store secret keys, private keys, database passwords, or sensitive
#   credentials in frontend environment files.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 1. API Configuration
# ----------------------------------------------------------------------------

# Public API Base URL
# Used by frontend client requests (Axios) to communicate with the Quittance backend server.
# Format:   Full scheme + hostname + path segment ending in `/api` (NO trailing slash).
# Status:   Required for backend communication (when mock mode is disabled).
# Examples:
#   Local dev:   http://localhost:3001/api
#   Production:  https://api.example.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ----------------------------------------------------------------------------
# 2. Stellar Network Configuration
# ----------------------------------------------------------------------------

# Stellar Network Mode
# Selects the target Stellar network for wallet connections (Freighter), transaction building,
# and block explorer link generation (stellar.expert).
# Format:   TESTNET (Stellar Testnet) or PUBLIC (Stellar Mainnet).
# Status:   Required for Stellar payment flows.
# Examples: TESTNET | PUBLIC
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Stellar Horizon REST Server URL
# Horizon API endpoint used by the frontend to fetch account balances, verify transactions,
# submit signed payment XDRs, and stream account activity.
# Format:   Full HTTPS URL (NO trailing slash).
# Status:   Optional (defaults automatically based on NEXT_PUBLIC_STELLAR_NETWORK if omitted).
# Examples:
#   Testnet: https://horizon-testnet.stellar.org
#   Public:  https://horizon.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# ----------------------------------------------------------------------------
# 3. Application & Branding Settings
# ----------------------------------------------------------------------------

# Public Frontend Application URL
# Base URL for the deployed frontend application. Used for generating invoice share URLs,
# QR code targets, copyable payment links, and export metadata.
# Format:   Full scheme + hostname (NO trailing slash).
# Status:   Required for invoice share link generation.
# Examples:
#   Local dev:   http://localhost:3000
#   Vercel:      https://quittance-app.vercel.app
#   Production:  https://app.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application Display Name
# Custom application branding string displayed across site headers, titles, and exported PDFs.
# Format:   Plain text string.
# Status:   Optional (defaults to 'Quittance' if omitted).
# Example:  Quittance
NEXT_PUBLIC_APP_NAME=Quittance

# Optional feedback inbox for /feedback (mailto). If unset, form opens a GitHub issue.
# NEXT_PUBLIC_FEEDBACK_EMAIL=you@example.com

# ----------------------------------------------------------------------------
# 4. Local Development & Mocking
# ----------------------------------------------------------------------------

# Enable Local Mock API
# Toggles between the local in-memory mock API and real backend API calls.
# Intended for standalone local UI development without running a backend server.
# Format:   true (use local mock data) | false (connect to real backend API).
# Status:   Optional (defaults to false when omitted or empty).
# IMPORTANT: Keep set to `false` in all deployed/production environments.
NEXT_PUBLIC_USE_MOCK=false
