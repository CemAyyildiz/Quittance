# Frontend environment variables for MVP deployments.
# Copy this file to a runtime environment file or set these values in Vercel.

# Public API base URL. The value must include /api.
# Example: https://api.example.com/api
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Stellar network for frontend wallet and payment flows.
# Use TESTNET for demos and PUBLIC for real production traffic.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Horizon endpoint for the selected Stellar network.
# Testnet example: https://horizon-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Public frontend URL. Do not include a trailing slash.
# Example: https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com

# Optional app name shown in the UI.
NEXT_PUBLIC_APP_NAME=Quittance

# Enable the local mock UI only for non-production testing.
# Keep this set to false for real deployments.
NEXT_PUBLIC_USE_MOCK=false
