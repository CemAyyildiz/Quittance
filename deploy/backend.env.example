[TEMPLATE]
# Backend environment variables for MVP deployments (in-memory server-mvp.ts).
# Copy this file to backend/.env on the VPS, then sudo systemctl restart quittance-api.
# See deploy/vps/README.md for the full VPS runbook.

# Server Configuration
PORT=3001
NODE_ENV=production

# Stellar Network
# Use TESTNET for demos and PUBLIC for mainnet production.
STELLAR_NETWORK=TESTNET

# Horizon endpoint for the selected Stellar network.
# Testnet: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional seller key placeholders (not required for MVP payment links).
# The MVP flow uses per-invoice sellerPublicKey from the wallet instead.
# SELLER_PUBLIC_KEY=
# SELLER_SECRET_KEY=

# Frontend / CORS
# The exact origin of the deployed frontend (Next.js / Vercel).
# Used for:
#   - CORS preflight (Access-Control-Allow-Origin)
#   - Generating payment URLs in API responses
#
# Rules:
#   - Include scheme and hostname, no trailing slash
#   - Must match the browser origin exactly
#
# Local example:  http://localhost:3000
# Prod example:   https://quittance-xxx.vercel.app
FRONTEND_URL=http://localhost:3000

# Local Testing
# Enable simulated Stellar transactions for local development only.
# Keep false or unset for production demos.
# ALLOW_SIMULATE=false
