# ----------------------------------------------------------------------------
# Quittance MVP backend - environment template
# ----------------------------------------------------------------------------
# Used by `backend/src/server-mvp.ts` (in-memory server for the public demo).
# Do NOT use this for the full Postgres / Redis stack behind
# `backend/src/server.ts`.
#
# Usage:
#   1. Copy this file to `backend/.env` on the VPS:
#        cp deploy/backend.env.example backend/.env
#   2. Edit the values below for your environment.
#   3. Restart the service:
#        sudo systemctl restart quittance-api
#
# See `deploy/vps/README.md` for the full VPS runbook and
# `deploy/wire-cors.md` for CORS wiring.
#
# IMPORTANT: never commit a real `.env`. Keep secrets (private keys,
# API tokens, webhook secrets) in your local `.env` only. This example
# file must contain placeholders and safe defaults only.
# ----------------------------------------------------------------------------

# -----------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------
# TCP port the MVP server binds to. The systemd unit and nginx config
# in `deploy/vps/` expect 3001 by default; change here AND in those
# files if you move off the default.
PORT=3001

# NOTE: NODE_ENV is only consumed by the full Postgres/Redis server.ts
#      path (config/database.ts). server-mvp.ts ignores it, so removing
#      or leaving it here does not affect the MVP demo behaviour.
#
# Runtime mode. `production` enables stricter defaults
# (no simulated Stellar payments), `development` enables verbose logs.
NODE_ENV=production

# -----------------------------------------------------------------------
# Stellar network markers
# -----------------------------------------------------------------------
# Selects which Stellar network the MVP server treats as "the network".
# Acceptable values:
#   TESTNET - public test network, free test XLM, safe for demos
#   PUBLIC  - Stellar mainnet; real funds, real consequence
STELLAR_NETWORK=TESTNET

# Horizon REST endpoint for the selected network. Pick the matching URL:
#   TESTNET  -> https://horizon-testnet.stellar.org
#   PUBLIC   -> https://horizon.stellar.org
# For private Horizon deployments or local Stellar Quickstart, supply that
#     host's Horizon base URL.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# -----------------------------------------------------------------------
# Optional seller key placeholders
# -----------------------------------------------------------------------
# The MVP flow takes `sellerPublicKey` per invoice from the seller's
# connected wallet, so these are not required for MVP payment links.
# They are kept here as commented placeholders for future server-side
# signers or for the full `server.ts` path.
# SELLER_PUBLIC_KEY=
# SELLER_SECRET_KEY=

# -----------------------------------------------------------------------
# CORS / frontend origin (required for browser clients)
# -----------------------------------------------------------------------
# Exact origin of the deployed frontend (Next.js / Vercel) - scheme plus
# hostname, NO trailing slash. Used for:
#   - Access-Control-Allow-Origin on preflight and API responses
#   - Building payment URLs returned by the API
# Must match the browser `window.location.origin` exactly, otherwise
# the browser blocks API calls.
#
# Examples:
#   Local dev:   http://localhost:3000
#   Vercel:      https://quittance-xxx.vercel.app
#   Production:  https://quittance.example.com
#
# IMPORTANT: edit this value to your deployed frontend origin and
# restart the service, otherwise the browser will be blocked by CORS
# (you will see `Access-Control-Allow-Origin` errors in DevTools).
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------
# Local development aids
# -----------------------------------------------------------------------
# When `true`, the backend accepts simulated Stellar payments for local
# demos without hitting Horizon. Keep `false` or unset for any deployed
# environment used for real customer demos.
# ALLOW_SIMULATE=false
