# Public production values for Vercel builds (no secrets).
# Cloudflare quick-tunnel hostname changes if `quittance-tunnel` is restarted —
# update this file + FRONTEND CORS is already set on the VPS.

NEXT_PUBLIC_API_URL=https://insertion-followed-agencies-rejected.trycloudflare.com/api
NEXT_PUBLIC_APP_URL=https://quittance-eosin.vercel.app
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_APP_NAME=Quittance
NEXT_PUBLIC_USE_MOCK=false
