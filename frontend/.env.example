# Quittance frontend environment reference.
#
# Copy this file to `.env.local` for local Next.js development, or set the
# variables in Vercel Project Settings when deploying. Anything prefixed with
# NEXT_PUBLIC_ is exposed to the browser bundle, so only safe, non-secret
# values belong here. Never commit real credentials or private keys.
#
#   cp .env.example .env.local

# Base URL of the backend API. Must be reachable from the browser and end in /api.
# Local dev: http://localhost:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Stellar network the frontend connects to: TESTNET or PUBLIC.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Horizon REST endpoint used to query balances, verify payments, and submit XDR.
# Testnet: https://horizon-testnet.stellar.org
# Public:  https://horizon.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Toggle the local in-memory mock API (true) or the real backend (false).
# Keep this false everywhere except local UI-only development.
NEXT_PUBLIC_USE_MOCK=false

# Optional inbox used by the /feedback form (mailto link).
# When unset, the feedback form opens a GitHub issue instead.
NEXT_PUBLIC_FEEDBACK_EMAIL=

# Public URL of this frontend (no trailing slash), used for share links and QR codes.
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Display name shown in headers, titles, and exported PDFs.
NEXT_PUBLIC_APP_NAME=Quittance